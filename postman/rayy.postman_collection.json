    {
      "name": "2. Webhook",
      "item": [
        {
          "name": "Full price after discount (webhook_2) -> 422, stays pending",
          "description": "Gateway charged 19999 but the discounted total is 17000.",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.variables.unset('bad_sig'); pm.variables.unset('event'); // flags are per-request",
                  "pm.variables.set('order_id','ord_a_1001'); pm.variables.set('amount_paise','19999'); pm.variables.set('payment_id','pay_a_7002');",
                  "",
                  "// Signs the EXACT body string that Postman sends ({{body}}) with HMAC-SHA256.",
                  "const secret = pm.collectionVariables.get('secret');",
                  "const payload = {",
                  "  event: pm.variables.get('event') || 'payment.succeeded',",
                  "  payment_id: pm.variables.get('payment_id'),",
                  "  order_id: pm.variables.get('order_id'),",
                  "  amount_paise: Number(pm.variables.get('amount_paise'))",
                  "};",
                  "const body = JSON.stringify(payload);",
                  "pm.variables.set('body', body);",
                  "pm.variables.set('sig', pm.variables.get('bad_sig') ? '0'.repeat(64) : CryptoJS.HmacSHA256(body, secret).toString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 422', () => pm.response.to.have.status(422));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Gateway-Signature",
                "value": "{{sig}}"
              }
            ],
            "url": "{{baseUrl}}/webhooks/payment",
            "body": {
              "mode": "raw",
              "raw": "{{body}}"
            }
          }
        },
